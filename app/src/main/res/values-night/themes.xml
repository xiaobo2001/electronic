<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Electronic" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 启动窗口背景与主界面深色基调一致，消除冷启动白闪（仅首帧前可见） -->
        <item name="android:windowBackground">@android:color/black</item>
        <!-- MD3 粉金色系（夜间）：弹窗按钮/选中态/输入框焦点色与 App 浪漫风格统一 -->
        <item name="colorPrimary">#FFFF69B4</item>
        <item name="colorOnPrimary">#FF1A0A14</item>
        <item name="colorSecondaryContainer">#3DFF69B4</item>
        <item name="colorOnSecondaryContainer">#FFFFD700</item>
        <!-- Customize your dark theme here. -->
        <!-- <item name="colorPrimary">@color/my_dark_primary</item> -->
    </style>
</resources>
