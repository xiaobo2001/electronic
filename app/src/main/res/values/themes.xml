<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      App 是夜空烟花场景，UI 恒为深色：
      原用 Theme.Material3.DayNight.NoActionBar，系统处于浅色模式时对话框/输入框会变成
      浅色底，而代码里大量硬编码 Color.WHITE 的文字（样式开关复选框、应答按钮等）会
      变成白底白字不可见。改用 Dark，无论系统深浅模式都保持夜空质感。
    -->
    <style name="Base.Theme.Electronic" parent="Theme.Material3.Dark.NoActionBar">
        <!-- 启动窗口背景与主界面深色基调一致，消除冷启动白闪（仅首帧前可见） -->
        <item name="android:windowBackground">@android:color/black</item>

        <!-- MD3 粉金色系：弹窗按钮/选中态/输入框焦点色与 App 浪漫风格统一 -->
        <item name="colorPrimary">@color/romantic_pink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">#3DFF69B4</item>
        <item name="colorOnSecondaryContainer">@color/gold</item>
        <!-- 复选框/滑块/开关等控件激活态走粉色，避免默认 MD3 紫破坏氛围 -->
        <item name="colorControlActivated">@color/romantic_pink</item>
        <item name="colorControlNormal">@color/text_secondary</item>

        <!-- EdgeToEdge：系统栏透明，实际留白交给 ViewCompat 的 WindowInsets 处理 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- 对话框统一大圆角，与底栏胶囊呼应 -->
        <item name="materialAlertDialogTheme">@style/RomanticDialog</item>
    </style>

    <style name="Theme.Electronic" parent="Base.Theme.Electronic" />

    <style name="RomanticDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/RomanticDialogShape</item>
    </style>

    <style name="RomanticDialogShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
</resources>
