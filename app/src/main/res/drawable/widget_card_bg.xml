<?xml version="1.0" encoding="utf-8"?>
<!--
  小组件共用卡片背景：深紫夜空竖向渐变 + 粉色描边金边。
  RemoteViews 只支持静态 shape，不能用 layer-list 叠加多个渐变，
  所以把"金边"做成 stroke、"夜空"做成 gradient，一层搞定。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#E61A0B2E"
        android:endColor="#F2080410"
        android:startColor="#F24A1240"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#99FFD700" />
</shape>
