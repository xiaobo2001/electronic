<?xml version="1.0" encoding="utf-8"?>
<!-- 【UI#24】小组件背景：粉金渐变圆角卡片，RemoteViews 兼容的静态 shape -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#CC8A0F35"
        android:startColor="#CC3D0A1F" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#66FF69B4" />
</shape>
