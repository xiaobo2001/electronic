<?xml version="1.0" encoding="utf-8"?>
<!-- 纪念日大号：一眼看完"哪一天 / 还有几天"，点整块进入告白 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💗 我们的纪念日"
        android:textColor="#FFFFE08A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="12"
        android:textColor="#FFFFD700"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_days_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="天"
        android:textColor="#FFE8E8E8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="表白纪念日"
        android:textColor="#FFFF69B4"
        android:textSize="13sp" />

    <Button
        android:id="@+id/widget_btn"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@null"
        android:text="放一场烟花 →"
        android:textColor="#FFE8E8E8"
        android:textSize="12sp" />
</LinearLayout>
