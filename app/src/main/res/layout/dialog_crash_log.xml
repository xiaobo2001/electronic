<?xml version="1.0" encoding="utf-8"?>
<!--
  崩溃日志查看。
  旧版正文放在 ScrollView 里写成 height=0dp + weight=1——父容器是 wrap_content，
  weight 无处可分，滚动区高度塌成 0，正文根本看不见。
  现在正文直接铺开，由 UiGuard 统一限高的内容区滚动；操作行放在最上面，
  「关闭」走系统按钮栏，内容再长也不会有"找不到按钮"的情况。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_crash_copy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="复制"
            android:textColor="@android:color/white"
            app:rippleColor="#33FFD700" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_crash_share"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="发送给我"
            android:textColor="#FFD700"
            app:rippleColor="#33FFD700" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_crash_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingHorizontal="12dp"
            android:text="清空"
            android:textColor="#FF99AABB"
            app:rippleColor="#33FFD700" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_crash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:paddingBottom="8dp"
        android:textColor="#FFE0E0E0"
        android:textSize="11sp"
        android:typeface="monospace" />

</LinearLayout>
