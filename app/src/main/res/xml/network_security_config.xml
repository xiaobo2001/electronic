<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
    模型整包服务器目前只开了 80 端口（443 不通），只能用 http。

    Android 9（targetSdk 28）起默认禁止明文流量，不放行的话下载会直接失败，
    而且报错信息只是"Cleartext traffic not permitted"，很难一眼看出是这里的问题。

    只对这一个地址放行，其余域名仍走系统默认的安全策略。
    等服务器配上 HTTPS，把 ModelRepo.BASE 改成 https 后，这一段就可以删掉。
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">8.130.169.254</domain>
    </domain-config>
</network-security-config>
