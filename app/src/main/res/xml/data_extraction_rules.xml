<?xml version="1.0" encoding="utf-8"?>
<!--
  云备份 / 换机迁移规则。
  应用已设置 android:allowBackup="false"，正常情况下系统不会备份任何数据；
  这里再显式排除一遍，防止个别 ROM 的厂商云备份绕过 allowBackup：
  真人录音（voice_note.m4a）、MMKV 里的名字/台词/回忆册都只应留在本机。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
