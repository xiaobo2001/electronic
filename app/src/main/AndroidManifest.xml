<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 权限用途详见项目根目录《隐私政策.md》或应用内「更多 → 权限说明」。
         本应用没有 INTERNET 权限：不含任何网络请求，全部数据只存本机。 -->

    <!-- 触感反馈：告白心跳、烟花爆炸的震动 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 相册读取（Android 12 及以下）：照片回忆墙 / 自定义背景，只读取用户选中的图片 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- 相册读取（Android 13 及以上）：用途同上 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- 动态壁纸：把烟花夜空设为系统壁纸 -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- 麦克风：① 音乐律动采集环境音量 ② 语音输入台词（离线识别）
         ③ 真人语音留声（录一句告白原声）。音频只在本机处理/保存，不上传。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 录制整场告白视频：前台录屏服务，用户主动点「录制整场」时才启用 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 通知：纪念日提醒、定时演出的到点提醒 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机启动：重启会清空 AlarmManager 闹钟，纪念日与定时演出需要开机重排 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 定时演出：到点在息屏/锁屏上全屏展开（闹钟类场景的正规通道） -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Android 11+ 包可见性：不声明则查询不到已安装的第三方 TTS 引擎（音色选择会是空的） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/icon1"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon1"
        android:supportsRtl="true"
        android:theme="@style/Theme.Electronic"
        tools:targetApi="31">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".media.ScreenRecorderService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 桌面小组件（四种，可同时摆在桌面） -->
        <receiver
            android:name=".ui.RomanticWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver
            android:name=".ui.AnniversaryWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_anniversary_info" />
        </receiver>

        <receiver
            android:name=".ui.DailyQuoteWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_quote_info" />
        </receiver>

        <receiver
            android:name=".ui.QuickActionsWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_quick_info" />
        </receiver>

        <!-- 纪念日提醒：开机/升级后重排闹钟；闹钟触发时发通知 -->
        <receiver
            android:name=".data.AnniversaryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 定时自动演出：开机/升级后重排；到点发全屏通知并开演 -->
        <receiver
            android:name=".show.ScheduledShowReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="com.xiaobo.electronic.ACTION_SCHEDULED_SHOW" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".view.FireworkWallpaperService"
            android:exported="true"
            android:label="烟花动态壁纸"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper_info" />
        </service>

    </application>

</manifest>